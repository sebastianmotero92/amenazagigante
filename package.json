{
  "name": "bga.amenazagigante",
  "version": "1.0.0",
  "description": "",
  "main": "amenazagigante.js",
  "scripts": {
    "build:ts": "tsc",
    "watch:ts": "tsc --watch",
    "build:scss": "sass --no-source-map src/amenazagigante.scss amenazagigante.css",
    "watch:scss": "sass --watch src/amenazagigante.scss amenazagigante.css",
    "watch": "npm run watch:ts & npm run watch:scss",
    "build": "npm run build:ts && npm run build:scss",
    "test": "XDEBUG_MODE=off phpunit --display-deprecations --display-warnings --bootstrap modules/php/_autoload.php --colors=always modules/php/tests",
    "predeploy": "php8.4 modules/php/_testpredeploy.php",
    "jstest": "TS_NODE_PROJECT=tests/tsconfig.test.json mocha -r ts-node/register tests/**/*.spec.ts",
    "end": "echo The End"
  },
  "author": "Sebastian Otero",
  "license": "ISC",
  "dependencies": {
    "bga-animations": "thoun/bga-animations#1.1.1",
    "bga-cards": "thoun/bga-cards#3.1.5",
    "bga-help": "thoun/bga-help#1.0.0",
    "bga-zoom": "thoun/bga-zoom#1.0.4"
  },
  "devDependencies": {
    "@prettier/plugin-php": "^0.22",
    "@types/chai": "^4.x.x",
    "@types/mocha": "^10.0.10",
    "@types/node": "^10.9.2",
    "@types/sinon": "^10.x.x",
    "chai": "^4.x.x",
    "jsdom": "^20.0.0",
    "mocha": "^10.x.x",
    "prettier": "^3.6",
    "sass": "^1.32.6",
    "sinon": "^15.x.x",
    "ts-node": "^10.9.2",
    "typescript": "^4.9.5"
  },
  "prettier": {
    "plugins": [
      "@prettier/plugin-php"
    ],
    "braceStyle": "1tbs",
    "printWidth": 140,
    "trailingComma": "none"
  }
}
