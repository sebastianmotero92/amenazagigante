      <div id="main_board">
        <div id="full-table">
          <div id="centered-table">
            <div id="giant-table-center">
              <div id="giant-table-row"></div>
            </div>
            <div id="heroe-table-center">
              <div id="heroe-table-row"></div>
            </div>
            <div id="city-table-center">
              <div id="city-table-row"></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

